# Copy this file to .env and fill in your secret. Never commit .env.

# Merchant client secret from https://merchant.gachagaming.com (sent as "Authorization: Bearer <secret>")
GACHA_CLIENT_SECRET=

# Optional overrides
GACHA_BASE_URL=https://api.gachagaming.com/open-api
GACHA_TIMEOUT_MS=15000

# Prefix for auto-generated merchantOrderId (your own order reference)
GACHA_ORDER_PREFIX=GIO

# true = build and validate orders but never call POST /transaction (no money spent)
GACHA_DRY_RUN=false

# ---------- Discord bot (npm run bot) ----------
# Bot token from discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Your server id (Discord: Settings -> Advanced -> Developer Mode, then right-click the server -> Copy Server ID)
DISCORD_GUILD_ID=
# Members with this role can start sessions and top up (right-click the role -> Copy Role ID)
DISCORD_TOPUP_ROLE_ID=
# Your own Discord user id(s), comma separated: can see everyone's audit, export CSV, /balance
DISCORD_ADMIN_IDS=
# Game used when /topup has no game option (slug or name)
DISCORD_DEFAULT_GAME=rf-online-next
# Optional: also post session/top-up log lines to this channel
DISCORD_LOG_CHANNEL_ID=

# Audit database file (SQLite). Back it up now and then.
AUDIT_DB_PATH=data/audit.db
# Time zone for "today" in /audit today
AUDIT_TIMEZONE=Asia/Singapore
# Sessions end automatically after this many hours without activity
SESSION_IDLE_HOURS=12
